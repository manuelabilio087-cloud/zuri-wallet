# ==== APP ====
APP_NAME=Zuri Wallet
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ==== DATABASE ====
POSTGRES_USER=zuri_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=zuri_wallet_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zuri_admin:change_me_in_production@db:5432/zuri_wallet_db

# ==== REDIS ====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ==== JWT / SECURITY ====
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ==== EMAIL (verificação / recuperação de senha) ====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=Zuri Wallet <no-reply@zuriwallet.com>

# ==== M-PESA (sandbox) ====
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_ORIGIN=
MPESA_ENV=sandbox

# ==== E-MOLA ====
EMOLA_API_KEY=
EMOLA_ENV=sandbox

# ==== EXCHANGE RATE API (câmbio de mercado real, não é a Binance) ====
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6
EXCHANGE_RATE_API_KEY=

# ==== BINANCE (única via de levantamento — nunca usada para câmbio) ====
# API key só com permissão "Enable Withdrawals" + whitelist de IP fixo.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEFAULT_NETWORK=BSC
WITHDRAWAL_MIN_AMOUNT_USD=10.0

# ==== NEXT.JS (frontend) ====
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
